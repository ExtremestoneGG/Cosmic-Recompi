@@ -0,0 +1,51 @@
+// Exact specialization of the existing Xenia/ReXGlue texture loader.
+// Xenos address mapping derived from the SDK's texture layout algorithm.
+// Xenia shader algorithm: Copyright 2022 Ben Vanik, BSD-3-Clause (SDK LICENSE).
+// Only 2D tiled, unscaled, single-layer, base-only, widths divisible by 8.
+// Same typed buffer bindings, root constants, thread layout and byte operations.
+#ifndef BEN10_TEXTURE_ENDIAN
+#error BEN10_TEXTURE_ENDIAN must be 0 or 2
+#endif
+#if BEN10_TEXTURE_ENDIAN != 0 && BEN10_TEXTURE_ENDIAN != 2
+#error Unsupported specialized byte order
+#endif
+cbuffer LoadConstants : register(b0) {
+  uint flags;
+  uint guest_offset;
+  uint guest_pitch;
+  uint guest_z_stride;
+  uint3 size_blocks;
+  uint host_offset;
+  uint host_pitch;
+  uint height_texels;
+};
+Buffer<uint4> source_data : register(t0);
+RWBuffer<uint4> dest_data : register(u0);
+
+uint TiledAddress(uint2 pixel) {
+  uint outer = ((pixel.y >> 5) * (guest_pitch >> 5) + (pixel.x >> 5)) << 6;
+  uint inner = (((pixel.y >> 1) & 7) << 3) | (pixel.x & 7);
+  uint combined = (outer | inner) << 2;
+  uint pipe = ((pixel.x >> 3) & 3) ^ (((pixel.y >> 3) & 1) << 1);
+  return ((pixel.y & 1) << 4) | (pipe << 6) | (((pixel.y >> 4) & 1) << 11)
+      | (combined & 15) | (((combined >> 4) & 1) << 5)
+      | (((combined >> 5) & 7) << 8) | ((combined >> 8) << 12);
+}
+uint4 ConvertEndian(uint4 value) {
+#if BEN10_TEXTURE_ENDIAN == 2
+  return ((value & 0x000000FFu) << 24) | ((value & 0x0000FF00u) << 8)
+      | ((value & 0x00FF0000u) >> 8) | (value >> 24);
+#else
+  return value;
+#endif
+}
+[numthreads(4,32,1)]
+void main(uint3 thread_id : SV_DispatchThreadID) {
+  uint2 pixel = thread_id.xy * uint2(8,1);
+  if (pixel.x >= size_blocks.x || pixel.y >= size_blocks.y) return;
+  uint src_byte = guest_offset + TiledAddress(pixel);
+  uint dst_vector = (host_offset + pixel.y * host_pitch + pixel.x * 4) >> 4;
+  dest_data[dst_vector] = ConvertEndian(source_data[src_byte >> 4]);
+  // X[2] is byte address bit 5. Pixel X is divisible by 8 here.
+  dest_data[dst_vector + 1] = ConvertEndian(source_data[(src_byte + 32) >> 4]);
+}
