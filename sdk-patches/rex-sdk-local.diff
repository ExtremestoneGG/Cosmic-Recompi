index 0000000..c80338e
--- /dev/null
+++ b/src/graphics/shaders/ben10_direct_resolve_rgba8_1x.cs.hlsl
@@ -0,0 +1,48 @@
+// Research candidate for the existing SDK resolve path, not selected at runtime.
+// Xenos tiling follows the SDK / Xenia algorithm (BSD-3-Clause, SDK LICENSE).
+// Domain: unscaled RGBA8 color, guest and owner 1x, equal base/pitch, one owner,
+// no source offset, no destination array, byte order 0 or 2, optional R/B swap.
+// Root constants remain the original five DWORDs. CPU integration must prove
+// complete ownership coverage and retain the generic path for every other case.
+cbuffer ResolveConstants : register(b0) {
+  uint edram_info;
+  uint coordinate_info;
+  uint dest_info;
+  uint dest_coordinate_info;
+  uint dest_base;
+};
+Texture2D<float4> source_image : register(t0);
+RWBuffer<uint4> dest_data : register(u0);
+
+uint TiledAddress(uint2 pixel, uint pitch) {
+  uint outer = ((pixel.y >> 5) * (pitch >> 5) + (pixel.x >> 5)) << 6;
+  uint inner = (((pixel.y >> 1) & 7) << 3) | (pixel.x & 7);
+  uint combined = (outer | inner) << 2;
+  uint pipe = ((pixel.x >> 3) & 3) ^ (((pixel.y >> 3) & 1) << 1);
+  return ((pixel.y & 1) << 4) | (pipe << 6) | (((pixel.y >> 4) & 1) << 11)
+      | (combined & 15) | (((combined >> 4) & 1) << 5)
+      | (((combined >> 5) & 7) << 8) | ((combined >> 8) << 12);
+}
+uint LoadPacked(uint2 pixel) {
+  // The SDK RT dump uses this UNORM conversion before the generic resolve.
+  uint4 value=uint4(source_image.Load(int3(pixel,0))*255.0f+0.5f);
+  if(dest_info & 0x01000000u) value=value.bgra;
+  uint packed=value.x|(value.y<<8)|(value.z<<16)|(value.w<<24);
+  if((dest_info & 7u)==2u)
+    packed=((packed & 255u)<<24)|((packed & 65280u)<<8)
+        |((packed & 16711680u)>>8)|(packed>>24);
+  return packed;
+}
+[numthreads(8,8,1)]
+void main(uint3 id:SV_DispatchThreadID) {
+  if(id.x>=((coordinate_info>>5)&2047u))return;
+  uint2 pixel=uint2(id.x*8,id.y);
+  uint4 first=uint4(LoadPacked(pixel),LoadPacked(pixel+uint2(1,0)),
+      LoadPacked(pixel+uint2(2,0)),LoadPacked(pixel+uint2(3,0)));
+  uint4 second=uint4(LoadPacked(pixel+uint2(4,0)),LoadPacked(pixel+uint2(5,0)),
+      LoadPacked(pixel+uint2(6,0)),LoadPacked(pixel+uint2(7,0)));
+  uint2 dest_pixel=pixel+uint2((dest_coordinate_info>>20)&15u,(dest_coordinate_info>>24)&15u)*8;
+  uint address=(dest_base+TiledAddress(dest_pixel,(dest_coordinate_info&1023u)*32))>>4;
+  dest_data[address]=first;
+  dest_data[address+2]=second;
+}
